# 「今天吃什么」后端 · HTTPS 反向代理配置
#
# 用途：把 http://YOUR_SERVER_IP:8080 变成 https://你的域名（443），
#       满足微信小程序对服务器域名的要求。
#
# 宝塔面板用法：
#   1. 网站 → 添加站点，域名只填你的域名（不建数据库、不建 FTP）
#   2. 站点设置 → SSL → Let's Encrypt 申请证书 → 打开「强制 HTTPS」
#   3. 站点设置 → 配置文件，用下面的 location / 段覆盖掉默认的
#
# ⚠️ 不要为了让小程序能访问就把 Node 监听的端口改成 443。
#    老安装包把 http://IP:8080 编译进了原生 AndroidManifest，
#    改端口它们就再也收不到更新了。8080 必须继续服务。

server {
    listen 80;
    server_name 你的域名;

    # 80 只做跳转；老安装包走的是 8080，不受这里影响
    return 301 https://$host$request_uri;
}

server {
    listen 443 ssl;
    server_name 你的域名;
    # nginx ≥ 1.25 可加这行开 HTTP/2：http2 on;

    # 证书必须是「完整链」（fullchain，含中间证书）。
    # 只配叶子证书时浏览器可能正常，但小程序 / 部分安卓会校验失败。
    # 下面两条是宝塔 Let's Encrypt 证书的默认路径，按实际情况改。
    ssl_certificate     /www/server/panel/vhost/cert/你的域名/fullchain.pem;
    ssl_certificate_key /www/server/panel/vhost/cert/你的域名/privkey.pem;

    # 微信要求 TLS 1.2 及以上，这里干脆只留 1.2 / 1.3
    ssl_protocols       TLSv1.2 TLSv1.3;
    ssl_ciphers         ECDHE-ECDSA-AES128-GCM-SHA256:ECDHE-RSA-AES128-GCM-SHA256:ECDHE-ECDSA-AES256-GCM-SHA384:ECDHE-RSA-AES256-GCM-SHA384:ECDHE-ECDSA-CHACHA20-POLY1305:ECDHE-RSA-CHACHA20-POLY1305;
    ssl_prefer_server_ciphers on;
    ssl_session_cache   shared:SSL:10m;
    ssl_session_timeout 10m;

    # 菜品照片单张最大 8MB（见 server/app.js 的限额），留余量；
    # APK 下载也走这个 server，别设太小。
    client_max_body_size 16m;
    client_body_timeout  120s;

    access_log /www/wwwlogs/你的域名.log;

    location / {
        proxy_pass http://127.0.0.1:8080;
        proxy_http_version 1.1;

        # ⚠️ 这三个头必须带，否则 server/app.js 里读不到真实 IP 和协议：
        #    没有 X-Forwarded-For  → 家庭码限流退化成全局限流
        #    没有 X-Forwarded-Proto → 更新地址会发成 http://
        proxy_set_header Host              $host;
        proxy_set_header X-Real-IP         $remote_addr;
        proxy_set_header X-Forwarded-For   $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header Connection        "";

        # 上传照片、下载 APK 都可能慢，别让网关先超时
        proxy_connect_timeout 30s;
        proxy_send_timeout    300s;
        proxy_read_timeout    300s;

        # OTA 的大文件不要缓冲写盘，直接透传
        proxy_buffering off;
    }

    # 微信域名校验文件默认由 Node 提供（server/wechat-verify/ 目录）。
    # 如果校验一直失败，可以在宝塔里改成静态文件方式：
    #
    # location = /xxxxxxxx.txt {
    #     root /www/wwwroot/你的域名;
    #     default_type text/plain;
    # }
}
